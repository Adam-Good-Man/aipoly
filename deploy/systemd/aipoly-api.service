[Unit]
Description=aiPoly API (Polymarket AI trading)
After=network.target postgresql-15.service
Wants=postgresql-15.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aipoly/api
Environment=GIN_MODE=release
ExecStart=/opt/aipoly/api/aipoly
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
