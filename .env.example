# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=aipoly

# Kimi / Moonshot (OpenAI-compatible)
# Get key: https://platform.kimi.com/console/api-keys
# (also accepts MOONSHOT_API_KEY)
OPENAI_API_KEY=your_moonshot_api_key_here
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL=kimi-k3

# Polymarket wallet
POLYMARKET_PRIVATE_KEY=
# For deposit wallet flow (after trading on polymarket.com): use proxyWallet from
# gamma-api.polymarket.com/public-profile?address=<EOA>, NOT the UUPS derived address
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_PAPER_TRADING=true
# 0=EOA, 1=PolyProxy, 2=Gnosis Safe, 3=POLY_1271 deposit wallet (new API users)
POLYMARKET_SIGNATURE_TYPE=0
# CLOB API host — use clob.polymarket.com if clob-v2 subdomain is blocked by proxy
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
# Optional: pre-created CLOB API credentials (auto-derived from private key if empty)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Builder API keys for relayer redeem (auto-created on first run if empty; save to .env)
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
POLYGON_RPC_URL=https://polygon-rpc.com

# Network proxy (if Polymarket/OpenAI unreachable)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Trading settings (active but risk-controlled)
INITIAL_BALANCE=1000
TRADING_INTERVAL_MINUTES=10
MAX_BET_PERCENT=8
# Only bet markets resolving within N days (short-term capital rotation)
MAX_MARKET_DAYS=2
# Keep this % as cash reserve (do not deploy all cash)
MIN_CASH_RESERVE_PERCENT=0
# Minimum AI self_win_rate (%) to place a bet
MIN_WIN_RATE=68
# Self win rate must beat market implied odds by this many points (keeps some edge without starving fills)
MIN_EDGE_PERCENT=2
MAX_TRADES_PER_CYCLE=1
# Skip markets that lost within this many hours (anti-revenge betting)
LOSS_COOLDOWN_HOURS=24
# Sell open position if mark falls this % below entry price
STOP_LOSS_PERCENT=30
# Profitable same-market add: max fraction of existing cost, and max extra buys
MAX_ADD_FRACTION=0.30
MAX_ADDS_PER_MARKET=1
# How often to check for settled markets and sync balance (minutes)
RESOLVER_INTERVAL_MINUTES=3

# API
API_PORT=8081

# Network proxy (required if Polymarket API is unreachable)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
